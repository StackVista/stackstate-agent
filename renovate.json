{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "github>StackVista/renovate-config#005e342f15c5481932542b5552b23cdd21e624a9",
      "github>StackVista/renovate-config:go#005e342f15c5481932542b5552b23cdd21e624a9",
      "github>StackVista/renovate-config:docker#005e342f15c5481932542b5552b23cdd21e624a9",
      "github>StackVista/renovate-config:automerge#005e342f15c5481932542b5552b23cdd21e624a9"
    ],
    "enabledManagers": ["custom.regex", "gomod", "pre-commit", "github-actions", "dockerfile", "docker-compose"],
    "labels": ["dependencies", "changelog/no-changelog", "qa/no-code-change"],
    "stopUpdatingLabel": "stop-updating",
    "platformCommit": "enabled",
    "packageRules": [
      {
        "matchDatasources": ["golang-version"],
        "matchUpdateTypes": ["patch"],
        "groupName": "Go build environment",
        "groupSlug": "go-build-environment",
        "automerge": true,
        "minimumReleaseAge": null,
        "rebaseWhen": "behind-base-branch"
      },
      {
        "matchDepNames": ["integrations-core"],
        "changelogUrl": "https://github.com/DataDog/integrations-core/compare/{{currentDigest}}..{{newDigest}}",
        "schedule": ["* 2-6 * * 1,3"]
      },
      {
        "matchDepNames": ["omnibus-ruby"],
        "changelogUrl": "https://github.com/DataDog/omnibus-ruby/compare/{{currentDigest}}..{{newDigest}}",
        "matchUpdateTypes": ["major", "minor", "patch"],
        "enabled": false
      },
      {
        "matchDepNames": ["linux-images"],
        "maxMajorIncrement": 0,
        "changelogUrl": "https://github.com/DataDog/datadog-agent-buildimages/commits/main",
        "schedule": ["* 2-6 * * 1-5"]
      },
      {
        "matchDepNames": ["windows-images"],
        "maxMajorIncrement": 0,
        "changelogUrl": "https://github.com/DataDog/datadog-agent-buildimages/commits/main",
        "schedule": ["* 2-6 2 * *"]
      },
      {
        "matchDepNames": ["DataDog/datadog-agent-dev"],
        "changelogUrl": "https://github.com/DataDog/datadog-agent-dev/releases/tag/v{{newValue}}",
        "schedule": ["* 1-4 5 6,12 *"]
      },
      {
        "matchManagers": ["github-actions"],
        "labels": ["dependencies", "dependencies-github-actions", "changelog/no-changelog", "qa/no-code-change"],
        "schedule": ["on saturday"]
      },
      {
        "matchManagers": ["dockerfile"],
        "labels": ["dependencies", "changelog/no-changelog", "qa/no-code-change"],
        "schedule": ["on saturday"]
      },
      {
        "matchManagers": ["docker-compose"],
        "labels": ["dependencies", "changelog/no-changelog", "qa/no-code-change"],
        "schedule": ["on saturday"]
      },
      {
        "matchManagers": ["docker-compose"],
        "matchFileNames": ["**/testdata/**", "**/fixtures/**", "**/testfixtures/**", "pkg/collector/corechecks/oracle/compose/**"],
        "enabled": false
      },
      {
        "matchUpdateTypes": ["major"],
        "enabled": false
      },
      {
        "matchManagers": ["gomod"],
        "matchDepTypes": ["require", "indirect", "replace"],
        "matchUpdateTypes": ["minor"],
        "matchJsonata": ["$not(isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion))"],
        "enabled": false
      },
      {
        "matchManagers": ["gomod"],
        "matchDepTypes": ["require", "indirect", "replace"],
        "matchUpdateTypes": ["minor"],
        "matchJsonata": ["isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion)"],
        "enabled": true,
        "automerge": true,
        "rebaseWhen": "behind-base-branch"
      },
      {
        "matchDepNames": [
          "/datadog/i",
          "github.com/StackVista/sketches-go",
          "integrations-core",
          "omnibus-ruby",
          "linux-images",
          "windows-images"
        ],
        "enabled": false
      },
    {
      "matchManagers": [
        "custom.regex",
        "github-actions"
      ],
      "matchPackageNames": [
        "StackVista/renovate-config"
      ],
      "groupName": "Renovate configuration",
      "groupSlug": "renovate-config",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false
    }
  ],
    "pre-commit": {
      "enabled": true,
      "managerFilePatterns": [".pre-commit-config.yaml"]
    },
    "customManagers" : [
      {
        "customType": "regex",
        "managerFilePatterns": ["/^\\.go-version$/", "/^go\\.work$/"],
        "matchStrings": [
          "(?:^|\\n)(?:go\\s+)?(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:\\s|$)"
        ],
        "depNameTemplate": "go",
        "depTypeTemplate": "toolchain",
        "datasourceTemplate": "golang-version"
      },
      {
        "customType": "regex",
        "managerFilePatterns": [".gitlab-ci.yml"],
        "matchStrings": [
          "  CI_IMAGE_[^W][^:]*: (?<currentValue>v.*)"
        ],
        "depNameTemplate": "linux-images",
        "versioningTemplate": "loose",
        "datasourceTemplate": "custom.linux-images"
      },
      {
        "customType": "regex",
        "managerFilePatterns": [".gitlab-ci.yml"],
        "matchStrings": [
          "  CI_IMAGE_WIN_[^:]*: (?<currentValue>v.*)"
        ],
        "depNameTemplate": "windows-images",
        "versioningTemplate": "regex:^(ltsc2022-)?v(?<major>\\d+)-.*$",
        "datasourceTemplate": "custom.windows-images",
        "extractVersionTemplate": "^(ltsc2022-)?(?<version>.*)$"
      },
      {
        "customType": "regex",
        "managerFilePatterns": [".protoc-version"],
        "matchStrings": [
          "(?<currentValue>[0-9]+.[0-9]+)"
        ],
        "depNameTemplate": "protocolbuffers/protobuf",
        "datasourceTemplate": "github-releases"
      },
      {
        "customType": "regex",
        "managerFilePatterns": [".dda/version"],
        "matchStrings": [
          "(?<currentValue>[0-9]+.[0-9]+.[0-9]+)"
        ],
        "depNameTemplate": "DataDog/datadog-agent-dev",
        "datasourceTemplate": "github-releases"
      },
      {
        "customType": "regex",
        "managerFilePatterns": ["release.json"],
        "matchStrings": [
          "[ ]+\"OMNIBUS_RUBY_VERSION\": \"(?<currentDigest>[a-z0-9]+)\""
        ],
        "currentValueTemplate": "datadog-5.5.0",
        "depNameTemplate": "omnibus-ruby",
        "packageNameTemplate": "https://github.com/DataDog/omnibus-ruby",
        "datasourceTemplate": "git-refs"
      },
      {
        "customType": "regex",
        "managerFilePatterns": ["release.json"],
        "matchStrings": [
          "[ ]+\"INTEGRATIONS_CORE_VERSION\": \"(?<currentDigest>[a-z0-9]+)\""
        ],
        "currentValueTemplate": "master",
        "depNameTemplate": "integrations-core",
        "packageNameTemplate": "https://github.com/DataDog/integrations-core",
        "datasourceTemplate": "git-refs"
      },
    {
      "customType": "regex",
      "description": "Track the release behind shared Renovate preset SHA pins.",
      "managerFilePatterns": [
        "/(^|/)renovate\\.json$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "^[\\s\\S]*\"description\"\\s*:\\s*\"Renovate release (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\"[\\s\\S]*$",
        "^[\\s\\S]*?(?:local|github)>StackVista/renovate-config(?:(?::|//)[^\"#]+)?#(?<currentDigest>[a-f0-9]{40})[\\s\\S]*$"
      ],
      "depNameTemplate": "StackVista/renovate-config",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{replace '((?:local|github)>StackVista/renovate-config(?:(?::|//)[^\"#]+)?#)[a-f0-9]{40}' (replace 'SHA' newDigest '$1SHA') (replace '(\"description\"\\s*:\\s*\"Renovate release )v[0-9]+\\.[0-9]+\\.[0-9]+' (replace 'VERSION' newValue '$1VERSION') replaceString)}}}"
    }
  ],
    "customDatasources": {
      "linux-images": {
        "defaultRegistryUrlTemplate": "https://hub.docker.com/v2/namespaces/datadog/repositories/agent-buildimages-linux/tags",
        "transformTemplates": [
          "{\"releases\": $map(results, function($v) { {\"version\": $v.name, \"releaseTimestamp\": $v.last_updated } }) }"
        ]
      },
      "windows-images": {
        "defaultRegistryUrlTemplate": "https://hub.docker.com/v2/namespaces/datadog/repositories/agent-buildimages-windows_x64/tags",
        "transformTemplates": [
          "{\"releases\": $map(results, function($v) { {\"version\": $v.name, \"releaseTimestamp\": $v.last_updated } }) }"
        ]
      }
    },
  "description": "Renovate release v1.0.0"
}
